{
  "info": {
    "name": "Educlic - Tienda API (sin DTOs)",
    "description": "Coleccion de pruebas CRUD. Los cuerpos usan las entidades directamente: las relaciones se envian como objeto anidado con solo el id, ej. \"categoria\": { \"id\": 1 }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (cliente semilla)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@tienda.com\",\n  \"password\": \"1234\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        { "name": "Listar usuarios", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/usuarios", "host": ["{{base_url}}"], "path": ["api", "usuarios"] } } },
        { "name": "Obtener usuario por id", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/usuarios/1", "host": ["{{base_url}}"], "path": ["api", "usuarios", "1"] } } },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Nuevo Cliente\",\n  \"email\": \"nuevo@tienda.com\",\n  \"password\": \"1234\",\n  \"telefono\": \"3001234567\",\n  \"rol\": \"CLIENTE\"\n}" },
            "url": { "raw": "{{base_url}}/api/usuarios", "host": ["{{base_url}}"], "path": ["api", "usuarios"] }
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Cliente Editado\",\n  \"email\": \"cliente@tienda.com\",\n  \"password\": \"1234\",\n  \"telefono\": \"3009999999\",\n  \"rol\": \"CLIENTE\"\n}" },
            "url": { "raw": "{{base_url}}/api/usuarios/1", "host": ["{{base_url}}"], "path": ["api", "usuarios", "1"] }
          }
        },
        { "name": "Desactivar usuario", "request": { "method": "PATCH", "url": { "raw": "{{base_url}}/api/usuarios/1/desactivar", "host": ["{{base_url}}"], "path": ["api", "usuarios", "1", "desactivar"] } } },
        { "name": "Eliminar usuario", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/usuarios/1", "host": ["{{base_url}}"], "path": ["api", "usuarios", "1"] } } }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        { "name": "Listar categorias", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/categorias", "host": ["{{base_url}}"], "path": ["api", "categorias"] } } },
        { "name": "Obtener categoria por id", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/categorias/1", "host": ["{{base_url}}"], "path": ["api", "categorias", "1"] } } },
        {
          "name": "Crear categoria",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Electronica\",\n  \"descripcion\": \"Dispositivos y accesorios electronicos\"\n}" },
            "url": { "raw": "{{base_url}}/api/categorias", "host": ["{{base_url}}"], "path": ["api", "categorias"] }
          }
        },
        {
          "name": "Actualizar categoria",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Electronica\",\n  \"descripcion\": \"Descripcion actualizada\"\n}" },
            "url": { "raw": "{{base_url}}/api/categorias/1", "host": ["{{base_url}}"], "path": ["api", "categorias", "1"] }
          }
        },
        { "name": "Eliminar categoria", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/categorias/1", "host": ["{{base_url}}"], "path": ["api", "categorias", "1"] } } }
      ]
    },
    {
      "name": "Productos",
      "item": [
        { "name": "Listar productos activos", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/productos", "host": ["{{base_url}}"], "path": ["api", "productos"] } } },
        { "name": "Listar productos por categoria", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/productos?categoriaId=1", "host": ["{{base_url}}"], "path": ["api", "productos"], "query": [{ "key": "categoriaId", "value": "1" }] } } },
        { "name": "Buscar productos por nombre", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/productos?nombre=mouse", "host": ["{{base_url}}"], "path": ["api", "productos"], "query": [{ "key": "nombre", "value": "mouse" }] } } },
        { "name": "Obtener producto por id", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/productos/1", "host": ["{{base_url}}"], "path": ["api", "productos", "1"] } } },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mouse inalambrico\",\n  \"descripcion\": \"Mouse ergonomico 2.4GHz\",\n  \"precio\": 45000,\n  \"stock\": 20,\n  \"imagenUrl\": \"https://ejemplo.com/mouse.jpg\",\n  \"categoria\": { \"id\": 1 }\n}" },
            "url": { "raw": "{{base_url}}/api/productos", "host": ["{{base_url}}"], "path": ["api", "productos"] }
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mouse inalambrico Pro\",\n  \"descripcion\": \"Version actualizada\",\n  \"precio\": 52000,\n  \"stock\": 15,\n  \"imagenUrl\": \"https://ejemplo.com/mouse-pro.jpg\",\n  \"categoria\": { \"id\": 1 }\n}" },
            "url": { "raw": "{{base_url}}/api/productos/1", "host": ["{{base_url}}"], "path": ["api", "productos", "1"] }
          }
        },
        { "name": "Desactivar producto", "request": { "method": "PATCH", "url": { "raw": "{{base_url}}/api/productos/1/desactivar", "host": ["{{base_url}}"], "path": ["api", "productos", "1", "desactivar"] } } },
        { "name": "Eliminar producto", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/productos/1", "host": ["{{base_url}}"], "path": ["api", "productos", "1"] } } }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Crear pedido (checkout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuario\": { \"id\": 1 },\n  \"nombreDestinatario\": \"Cliente de Prueba\",\n  \"telefonoContacto\": \"3000000000\",\n  \"direccion\": \"Calle 10 # 20-30\",\n  \"ciudad\": \"Medellin\",\n  \"codigoPostal\": \"050001\",\n  \"notas\": \"Entregar en la porteria\",\n  \"detalles\": [\n    { \"producto\": { \"id\": 1 }, \"cantidad\": 2 }\n  ]\n}" },
            "url": { "raw": "{{base_url}}/api/pedidos", "host": ["{{base_url}}"], "path": ["api", "pedidos"] }
          }
        },
        { "name": "Listar todos los pedidos (admin)", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/pedidos", "host": ["{{base_url}}"], "path": ["api", "pedidos"] } } },
        { "name": "Listar pedidos de un usuario", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/pedidos?usuarioId=1", "host": ["{{base_url}}"], "path": ["api", "pedidos"], "query": [{ "key": "usuarioId", "value": "1" }] } } },
        { "name": "Obtener pedido por id", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/pedidos/1", "host": ["{{base_url}}"], "path": ["api", "pedidos", "1"] } } },
        { "name": "Cambiar estado de pedido", "request": { "method": "PATCH", "url": { "raw": "{{base_url}}/api/pedidos/1/estado?estado=ENVIADO", "host": ["{{base_url}}"], "path": ["api", "pedidos", "1", "estado"], "query": [{ "key": "estado", "value": "ENVIADO" }] } } }
      ]
    }
  ]
}